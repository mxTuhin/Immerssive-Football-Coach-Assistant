# Copy to infra/.env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me
FMI_API_TOKEN=                       # set a long random string to require "Authorization: Bearer <token>"
ANTHROPIC_API_KEY=                   # AI analyst (Claude). Or use `ant auth login` on the host.
FMI_AGENT_MODEL=claude-opus-5-5
FMI_AGENT_FALLBACKS=default          # server-side refusal fallback; "off" to disable

# Storage: leave FMI_S3_BUCKET empty for local disk; set for Cloudflare R2 / MinIO
FMI_S3_BUCKET=
FMI_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
FMI_S3_PREFIX=fmi
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: YAML overriding PipelineConfig thresholds
FMI_PIPELINE_CONFIG=
